{
  "manifest_version": 3,
  "name": "Твинкл: помощник голосования",
  "short_name": "Твинкл",
  "version": "0.1.1",
  "description": "Серверы WARGM в одном месте, напоминания через 16 часов и переход к ручному голосованию.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть Твинкл",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}

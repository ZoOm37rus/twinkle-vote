{
  "manifest_version": 3,
  "name": "Твинкл: помощник голосования",
  "short_name": "Твинкл",
  "version": "0.2.0",
  "description": "15 основных серверов и 4 Сталкера. Вы голосуете на WARGM, Твинкл открывает следующий сервер после появления таймера.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть Твинкл",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "host_permissions": [
    "https://wargm.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wargm.ru/server/*/votes*"
      ],
      "js": [
        "vote-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
